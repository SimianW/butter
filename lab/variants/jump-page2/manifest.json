{
  "manifest_version": 3,
  "name": "Butter for ChatGPT",
  "version": "0.1.0.2",
  "version_name": "0.1.0-alpha.2",
  "description": "Keeps long ChatGPT conversations smooth while answers stream, with a history rail to jump between questions.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["butter.css"],
      "js": ["butter-nav.js", "butter-cv.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["config.js", "butter-main.js", "butter-nav-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
