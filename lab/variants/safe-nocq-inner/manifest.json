{
  "manifest_version": 3,
  "name": "ChatGPT Turbo",
  "version": "0.1.0",
  "description": "Makes long ChatGPT conversations stay smooth while answers stream.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["turbo.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["config.js", "turbo-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
