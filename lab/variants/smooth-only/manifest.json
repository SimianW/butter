{
 "manifest_version": 3,
 "name": "Butter for ChatGPT",
 "version": "0.1.0",
 "description": "Makes long ChatGPT conversations stay smooth while answers stream.",
 "content_scripts": [
  {
   "matches": [
    "https://chatgpt.com/*"
   ],
   "js": [
    "config.js",
    "butter-main.js"
   ],
   "world": "MAIN",
   "run_at": "document_start"
  }
 ]
}