{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.0.16",
  "version_name": "0.1.0-alpha.16",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["stream/containment.css"],
      "js": [
        "shared/status.js",
        "storage/layout-bridge.js",
        "shared/settings.js",
        "consent/card.js",
        "consent/layout-consent.js",
        "seek/seek-meta.js",
        "bookmarks/model.js",
        "rail/rail.js",
        "bookmarks/content.js",
        "bookmarks/notice.js",
        "stream/offscreen.js",
        "branch/logic.js",
        "branch/run.js",
        "branch/page.js",
        "branch/ui.js",
        "branch/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*"],
      "js": [
        "shared/config-main.js",
        "stream/throttle-main.js",
        "history/conversation-main.js",
        "seek/core-main.js",
        "seek/layout-check-main.js",
        "seek/anchor-main.js",
        "seek/layout-codec.js",
        "seek/layout-cache-main.js",
        "seek/preview-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": ["storage", "unlimitedStorage"],
  "commands": {
    "bookmark": {
      "suggested_key": { "default": "Alt+Shift+M", "mac": "Alt+Shift+M" },
      "description": "__MSG_bookmarkCommand__"
    }
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "storage/layout-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["popup/fonts/nunito-latin.woff2"],
      "matches": ["https://chatgpt.com/*"],
      "use_dynamic_url": true
    }
  ],
  "default_locale": "en"
}
