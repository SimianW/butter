{
  "manifest_version": 3,
  "name": "Butter for ChatGPT",
  "version": "0.1.0.9",
  "version_name": "0.1.0-alpha.9",
  "description": "Keeps long ChatGPT conversations smooth while answers stream, with a history rail to jump between questions.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "css": [
        "butter.css"
      ],
      "js": [
        "butter-status.js",
        "butter-settings.js",
        "butter-nav.js",
        "butter-cv.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "config.js",
        "butter-main.js",
        "butter-nav-main.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
