{
  "name": "butter-for-chatgpt",
  "private": true,
  "scripts": {
    "check": "npm run format:check && npm run lint && node --test && python3 -m unittest discover -s scripts -p 'test_*.py' && python3 scripts/check-version.py",
    "format": "prettier --write \"extension/**/*.{js,css,html,json}\" \"test/**\"",
    "format:check": "prettier --check \"extension/**/*.{js,css,html,json}\" \"test/**\"",
    "lint": "eslint .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "espree": "10.4.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "playwright": "1.65.0",
    "prettier": "3.6.2"
  }
}
